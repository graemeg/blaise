<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>blaise-stdlib</name>

  <build>
    <packaging>library</packaging>
    <unitPaths>
      <!-- The RTL units (runtime.*.pas) live in the compiler's own source
           tree; runtime/src/main/pascal no longer exists. -->
      <path>../compiler/src/main/pascal</path>
    </unitPaths>
    <bootstrapExclude>
      <unit>Net.Tls.Provider</unit>
      <unit>Net.Tls</unit>
      <unit>Net.Http.Client.Tls</unit>
      <!-- Per-OS reactors: both define the same CreateOsReactor factory, so
           an all-units bootstrap program holding both fails with a duplicate
           identifier.  BOTH are excluded here: each OS's reactor reaches the
           program transitively through async.fibers' target-driven seam, so
           excluding only kqueue still broke FreeBSD hosts (the bootstrap
           force-included epoll while the seam pulled kqueue — GH #197). -->
      <unit>async.reactor.epoll</unit>
      <unit>async.reactor.kqueue</unit>
    </bootstrapExclude>
  </build>

  <test>
    <framework>blaise</framework>
    <testSource>testrunner.pas</testSource>
  </test>

</project>
