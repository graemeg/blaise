<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>blaise-migration</name>
  <!-- version inherited from root aggregator -->

  <build>
    <packaging>application</packaging>
    <mainSource>MigrationAnalyser.pas</mainSource>
    <executableName>cp-migrate</executableName>

    <manualUnitPaths>true</manualUnitPaths>
    <unitPaths>
      <path>src/main/pascal</path>
      <path>src/test/pascal</path>
      <!-- The compiler's tokeniser (uPasTokeniser): rules read the raw token
           stream, which evaluates no conditional directives. -->
      <path>../../compiler/src/main/pascal</path>
      <!-- stdlib: generic collections, IO.Files, the test framework -->
      <path>../../stdlib/src/main/pascal</path>
    </unitPaths>
  </build>

  <test>
    <framework>blaise</framework>
    <testSource>TestRunner.pas</testSource>
  </test>

  <moduleDependencies>
    <module>../../compiler</module>
  </moduleDependencies>
</project>
